{
  "name": "cms-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci",
    "dev": "npm run serve:mcp",
    "dev:legacy-netlify": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:drift": "tsx scripts/twoPlaneDrift.ts",
    "drift:update": "tsx scripts/twoPlaneDrift.ts --write",
    "test:nodes": "tsx scripts/seedNodesFromWorkspace.ts",
    "nodes:check": "tsx scripts/seedNodesFromWorkspace.ts",
    "nodes:update": "tsx scripts/seedNodesFromWorkspace.ts --write",
    "nodes:check:offline": "tsx scripts/seedNodesFromWorkspace.ts --from-canonical",
    "store:check": "tsx scripts/reseedStoreFromCanonical.ts",
    "store:update": "tsx scripts/reseedStoreFromCanonical.ts --write",
    "test:glossary": "tsx scripts/generateGlossary.ts",
    "glossary:update": "tsx scripts/generateGlossary.ts --write",
    "test:objects": "tsx scripts/generateObjectDocs.ts",
    "objects:update": "tsx scripts/generateObjectDocs.ts --write",
    "test:scope": "tsx scripts/siteCredentialScopeLock.ts",
    "scope:update": "tsx scripts/siteCredentialScopeLock.ts --write",
    "verify:deploy": "tsx scripts/verifyDeployment.ts",
    "learning:purge-align": "tsx scripts/purgeAlignObservations.ts",
    "deploy:mcp": "bash scripts/deploy-mcp.sh",
    "build": "npm run typecheck",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "workbench:dev": "npm --prefix workbench run dev",
    "workbench:build": "npm --prefix workbench run build",
    "workbench:test": "npm --prefix workbench run test",
    "broker:dev": "npm --prefix workbench-broker run dev",
    "broker:test": "npm --prefix workbench-broker test",
    "test:openai:smoke": "node scripts/openai-smoke.mjs",
    "test:ui": "npm --prefix ui run test",
    "job:conductor": "tsx src/agent/entrypoints/runConductorJobMain.ts",
    "job:conversation-turn-gc": "tsx src/agent/entrypoints/conversationTurnGcJobMain.ts",
    "job:migrate-store": "tsx src/agent/entrypoints/migrateStoreJobMain.ts",
    "job:monetizer-ingest": "tsx src/agent/entrypoints/monetizerIngestJobMain.ts",
    "serve:mcp": "tsx src/agent/entrypoints/mcpServerMainRun.ts",
    "job:continuation-tick": "tsx src/agent/entrypoints/runContinuationTickMain.ts",
    "job:reconcile-site-credentials": "tsx src/agent/entrypoints/reconcileSiteCredentialsMain.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@netlify/blobs": "^10.7.9",
    "@openai/agents": "^0.13.1",
    "openai": "^6.46.0",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "netlify-cli": "^17.38.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
