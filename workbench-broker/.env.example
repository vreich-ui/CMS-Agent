# Conductor Workbench broker — environment variables.
# Copy this file to .env and fill in real values. The server FAILS FAST on
# startup if a required variable is missing or malformed — see the exact
# error it prints for which one and why.

# --- Server -------------------------------------------------------------

# Port the broker's HTTP server listens on. Cloud Run injects its own PORT
# at deploy time (see Dockerfile.workbench / cloudbuild.workbench.yaml) —
# this default only matters for local dev.
PORT=8787

# --- Auth / access control -------------------------------------------------

# How the broker decides who's asking:
#   iap (default)   — trust only a verified Google IAP JWT
#                      (X-Goog-IAP-JWT-Assertion). This is the deployed
#                      mode: Wolf opens one URL, IAP has already gated
#                      access at the load balancer, and this broker reads
#                      his identity off the signed assertion — never off
#                      the spoofable X-Goog-Authenticated-User-Email header
#                      alone. See src/iap.ts.
#   password        — the original cookie-session login flow (POST
#                      /api/login with OPERATOR_PASSWORD_HASH below). Use
#                      this for local dev or any deployment not sitting
#                      behind IAP. The password endpoints stay present and
#                      working under iap mode too (never deleted) — they're
#                      just not the access gate there; POST /api/login
#                      under iap mode returns a clear "no password needed
#                      here" message instead of checking one.
AUTH_MODE=iap

# Expected `aud` claim on the IAP JWT — the backend service / load balancer
# resource this deployment is authorized for. Optional: leave unset to skip
# audience pinning (signature + issuer + expiry are still verified) while
# you don't yet know the value; docs/plan/TRACK-A-RUNBOOK.md shows how to
# read the real value off the running Cloud Run + IAP service once it's up,
# and you should set this for real once you have it. Ignored outside
# AUTH_MODE=iap.
IAP_AUDIENCE=

# Secret used to HMAC-sign session cookies. Required, must be >= 32 chars,
# even under AUTH_MODE=iap (the login endpoints still exist and still need
# a real secret if anyone ever calls them).
# Without it: the server refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The operator's password, hashed (never store the plaintext password
# anywhere). Required (even under AUTH_MODE=iap, for the same reason as
# SESSION_SECRET above). Format: scrypt$N$r$p$salt_b64$hash_b64
# Generate one with:
#   npm run hash -- '<the operator password>'
OPERATOR_PASSWORD_HASH=

# --- MCP workspace credentials ---------------------------------------------

# Base URL of the CMS Agent MCP Streamable-HTTP endpoint this broker talks to.
# Required (unless MOCK_UPSTREAM=1). Without it: the server refuses to start,
# because /api/mcp would have nowhere to forward calls.
CMS_AGENT_MCP_URL=

# --- MCP bearer token: exactly ONE of these two, never both -----------------

# PREFERRED for any real deploy. A Google Secret Manager SECRET VERSION
# resource name — "projects/<project>/secrets/<name>/versions/<latest|N>" —
# holding the MCP bearer token. Resolved ONCE at process startup (see
# src/secrets.ts) via this Cloud Run service's own identity; the value is
# never written to disk, never logged, never sent to the browser, and never
# appears in an error message. When this is set, CMS_AGENT_MCP_TOKEN below
# is ignored. The runtime service account needs
# roles/secretmanager.secretAccessor on this secret — see
# docs/plan/TRACK-A-RUNBOOK.md.
CMS_AGENT_MCP_TOKEN_SECRET=

# LOCAL DEV FALLBACK ONLY. The plain bearer token, when you aren't running
# against Secret Manager. Required only if CMS_AGENT_MCP_TOKEN_SECRET is
# unset and MOCK_UPSTREAM is not "1". Never commit a real value here — this
# file is committed as an example; your real .env is gitignored.
CMS_AGENT_MCP_TOKEN=

# --- Safety -----------------------------------------------------------------

# When "1" (the default), every mutating MCP verb is refused with 403,
# regardless of who is asking. This is the server-side guarantee — the UI's
# own read-only mode is a courtesy on top of this, not a substitute for it.
# Set to "0" once Wolf has explicitly decided mutations may proceed — the
# deployed config for Track A does exactly this; see
# docs/plan/TRACK-A-RUNBOOK.md.
# A misconfigured deploy (this var unset, or set to something unrecognized)
# stays in the safe state: READ_ONLY defaults ON.
READ_ONLY=1

# --- Read-verb response cache -----------------------------------------------

# TTL, in milliseconds, for the short-lived response cache covering read
# verbs only (mutating verbs always bypass it and invalidate it). 10-30
# seconds is the sane range for a single-operator console; default below.
CACHE_TTL_MS=20000

# --- Static SPA serving (single-origin, A1.1) -------------------------------

# Directory containing the built Conductor Workbench SPA (workbench/dist,
# copied in by Dockerfile.workbench at image build time). Unset or missing
# an index.html -> static serving is simply unavailable (a clean 404 for
# any non-/api/ path), not a startup failure — this lets the broker still
# run standalone (its original deploy shape, still supported via
# workbench-broker/Dockerfile) with no SPA bundled in.
STATIC_ROOT=public

# --- CORS -------------------------------------------------------------------

# The single origin the SPA is served from. The broker reflects exactly this
# origin (with Access-Control-Allow-Credentials: true) and nothing else —
# never "*" with credentials. Matters only for local dev (Vite dev server on
# a different port than the broker) or a split deploy where the SPA is NOT
# served by this broker itself — once Dockerfile.workbench serves both from
# one origin, the browser never sends a cross-origin request here at all and
# this setting is inert. Without it: defaults to the Vite dev server origin
# (http://localhost:5173).
ALLOWED_ORIGIN=http://localhost:5173

# --- Development / testing only ----------------------------------------

# When "1", src/mcp.ts never makes a real network call — it returns canned
# results instead. Lets the full HTTP surface (login -> session -> mcp ->
# logout, plus batching and bootstrap) be exercised end-to-end without real
# MCP credentials. Leave unset (or "0") in any real deployment.
MOCK_UPSTREAM=0
