# Conductor Workbench broker — environment variables.
# Copy this file to .env and fill in real values. The server FAILS FAST on
# startup if a required variable is missing or malformed — see the exact
# error it prints for which one and why.

# --- Server -------------------------------------------------------------

# Port the broker's HTTP server listens on.
PORT=8787

# --- Auth / sessions ------------------------------------------------------

# Secret used to HMAC-sign session cookies. Required, must be >= 32 chars.
# Without it: the server refuses to start (a session system with a guessable
# or missing secret means anyone can forge a login).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The operator's password, hashed (never store the plaintext password
# anywhere). Required. Format: scrypt$N$r$p$salt_b64$hash_b64
# Without it: the server refuses to start (no password to check logins
# against means /api/login can never succeed, or worse, would have to be
# left open).
# Generate one with:
#   npm run hash -- '<the operator password>'
OPERATOR_PASSWORD_HASH=

# --- MCP workspace credentials ---------------------------------------------

# Base URL of the CMS Agent MCP Streamable-HTTP endpoint this broker talks to.
# Required (unless MOCK_UPSTREAM=1). Without it: the server refuses to start,
# because /api/mcp would have nowhere to forward calls.
CMS_AGENT_MCP_URL=

# Bearer token for the MCP endpoint above. Required (unless MOCK_UPSTREAM=1).
# This token lives ONLY in this env var and the outbound Authorization header
# built in src/mcp.ts — it is never logged, never returned in any response.
# Without it: the server refuses to start.
CMS_AGENT_MCP_TOKEN=

# --- Safety -----------------------------------------------------------------

# When "1" (the default), every mutating MCP verb is refused with 403,
# regardless of who is asking. This is the server-side guarantee — the UI's
# own read-only mode is a courtesy on top of this, not a substitute for it.
# Set to "0" only when Wolf has explicitly decided mutations may proceed.
# A misconfigured deploy (this var unset, or set to something unrecognized)
# stays in the safe state: READ_ONLY defaults ON.
READ_ONLY=1

# --- CORS -------------------------------------------------------------------

# The single origin the SPA is served from. The broker reflects exactly this
# origin (with Access-Control-Allow-Credentials: true) and nothing else —
# never "*" with credentials. Without it: defaults to the Vite dev server
# origin (http://localhost:5173), which will not match a deployed SPA and
# every request from it will be blocked by the browser's CORS check.
ALLOWED_ORIGIN=http://localhost:5173

# --- Development / testing only ----------------------------------------

# When "1", src/mcp.ts never makes a real network call — it returns canned
# results instead. Lets the full HTTP surface (login -> session -> mcp ->
# logout) be exercised end-to-end without real MCP credentials. Leave unset
# (or "0") in any real deployment.
MOCK_UPSTREAM=0
